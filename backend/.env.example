# =============================================================================
# Backend (Flask) 環境変数サンプル
# =============================================================================
# このファイルを `backend/.env` にコピーして実値を埋める。
# 実 .env は `.gitignore` 対象（コミット禁止）。
#
# 凡例:
#   [local]  ローカル開発 (`python src/main.py`) で必要
#   [cloud]  Cloud Run で必要（Terraform `terraform/cloudrun.tf` が注入）
#   [both]   両方の環境で必要
#   [opt]    任意（未設定でも動作）
# -----------------------------------------------------------------------------
# Cloud Run 環境では Terraform が env を直接注入するため、Cloud 環境では
# このファイルは使用されない。Terraform で管理される値は `terraform/cloudrun.tf`
# および `terraform/environments/<env>.tfvars` を参照。
# 横断的なマトリクスは `docs/features/ENVIRONMENT.md` を参照。
# =============================================================================


# ===== Logging =====

# [both][opt] ログレベル (DEBUG|INFO|WARNING|ERROR)。大文字小文字許容。
# デフォルト: FLASK_DEBUG truthy なら DEBUG、それ以外は INFO。
LOG_LEVEL=DEBUG

# [local][opt] Flask デバッグモード。truthy で LOG_LEVEL のデフォルトが DEBUG に。
# Cloud 環境では設定しない（Gunicorn 起動）。
FLASK_DEBUG=1


# ===== Model inference (/api/model_inference) =====

# [cloud] GCS バケット名（Patchcore モデル checkpoint の取得元）。
# ローカルでは未設定で OK（モデルファイルを backend/src/models/ に手動配置すれば動作）。
# Cloud Run では Terraform が `google_storage_bucket.models.name` を自動注入。
MODEL_GCS_BUCKET=

# [cloud] GCS 上の checkpoint パス。Cloud Run では Terraform が `models/model.ckpt` を注入。
MODEL_GCS_PATH=

# [opt] モデル checkpoint のキャッシュ先ディレクトリ（明示指定したい場合）。
# 未設定時の挙動: Cloud Run (K_SERVICE 自動付与) は /tmp、ローカルは src/models/。
# MODEL_CACHE_DIR=


# ===== Limits =====

# [both][opt] アップロード最大バイト数。デフォルト: 16777216 (16MB)。
# MAX_CONTENT_LENGTH=16777216


# ===== Cloud Run が自動付与（手動設定不要） =====
# - K_SERVICE     Cloud Run ランタイムが自動付与（コードがこれを見て /tmp を選ぶ）
# - PORT          Cloud Run が 8080 を渡す。Dockerfile の Gunicorn が参照
# - GOOGLE_APPLICATION_CREDENTIALS  GCS アクセス: Cloud Run は SA で自動、ローカルは
#                                   `gcloud auth application-default login` 推奨
