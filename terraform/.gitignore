*.tfstate
*.tfstate.backup
*.tfstate.*.backup
.terraform/
terraform.tfvars
*.auto.tfvars
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

DEPLOY.md
.terraform.tfstate.lock.info
.terraform.lock.hcl

# Per-environment variable files (real values, may contain secrets).
# Only the *.example templates are committed.
environments/*.tfvars
!environments/*.tfvars.example

# Per-environment state files.
# Keep the directory (.gitkeep) but ignore all state contents.
states/*
!states/.gitkeep
