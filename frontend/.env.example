# =============================================================================
# Frontend (Next.js) 環境変数サンプル
# =============================================================================
# このファイルを `frontend/.env` にコピーして実値を埋める。
# 実 .env は `.gitignore` 対象（コミット禁止）。
#
# 凡例:
#   [local]  ローカル開発 (`pnpm dev`) で必要
#   [cloud]  Cloud Run で必要（Terraform `terraform/cloudrun.tf` が注入）
#   [both]   両方の環境で必要
#   [opt]    任意（未設定でも動作）
# -----------------------------------------------------------------------------
# Cloud Run 環境では Terraform が env を直接注入するため、Cloud 環境では
# このファイルは使用されない。横断的なマトリクスは
# `docs/features/ENVIRONMENT.md` を参照。
# =============================================================================


# ===== Required =====

# [both] バックエンド API のベース URL。
# ローカル: http://localhost:8080
# Cloud:   Terraform が backend Cloud Run の URI を `google_cloud_run_v2_service.backend.uri` 経由で注入
API_BASE_URL=http://localhost:8080

# [both] Gemini API キー（AI チャット機能）。
# ローカル: 生値をここに記載
# Cloud:   tfvars の `gemini_api_key` → Secret Manager → Cloud Run env (`value_source.secret_key_ref`)
GEMINI_API_KEY=


# ===== Logging =====

# [both][opt] pino ログレベル (trace|debug|info|warn|error|fatal)。
# デフォルト: NODE_ENV=development なら debug、production なら info。
LOG_LEVEL=debug

# [cloud][opt] Cloud Logging 統合を有効化（@google-cloud/logging-pino にルーティング）。
# ローカルでは "true" にしない（pino-pretty で十分）。
# Cloud Run では Terraform が "true" を注入。
# ENABLE_CLOUD_LOGGING=

# [cloud][opt] Cloud Trace 連携用 GCP プロジェクト ID。
# ローカルでは未設定で OK（trace 紐付けが無効になるだけ）。
# Cloud Run では Terraform が `google_project.main.project_id` を自動注入。
GCP_PROJECT=


# ===== 自動付与（手動設定不要） =====
# - NODE_ENV  next dev/start が development/production を自動セット
# - PORT      Cloud Run が 3000 を渡す。ローカルでは pnpm dev のデフォルト 3000
# - K_SERVICE / GOOGLE_CLOUD_PROJECT  Cloud Run ランタイムが自動付与
