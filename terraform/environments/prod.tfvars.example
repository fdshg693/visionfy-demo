# =============================================================================
# Production environment variables (Terraform / Cloud Run)
# =============================================================================
# Copy this file to `prod.tfvars` and fill in real values.
# `prod.tfvars` is gitignored (it contains secrets like gemini_api_key).
#
# 横断的な env マトリクスは `docs/features/ENVIRONMENT.md` を参照。
# このファイルで定義した値は Terraform が Cloud Run の `env` ブロックに注入する。
# =============================================================================

# --- GCP project ---
project_id      = "visionfy-demo-prod"
project_name    = "Visionfy Demo"
billing_account = "AABBCC-DDEEFF-112233"
region          = "asia-northeast1"

# --- Container image tags ---
# In prod we pin to an immutable release tag (e.g. a git SHA or semver).
backend_image_tag  = "latest"
frontend_image_tag = "latest"

# --- Runtime env (Cloud Run) ---
# prod はノイズを抑えて INFO 以上のみ。
backend_log_level             = "INFO"
frontend_log_level            = "info"
frontend_enable_cloud_logging = true
# Patchcore checkpoint の GCS オブジェクトパス。通常 default のままで OK。
# model_gcs_object_path       = "models/model.ckpt"

# --- Secrets (DO NOT commit prod.tfvars) ---
gemini_api_key = "your-prod-gemini-api-key-here"
